stage('Python Version') {
    steps {
        dir('python') {
            sh 'python3 --version'
        }
    }
}

stage('Install Dependencies') {
    steps {
        dir('python') {
            sh 'python3 -m pip install -r requirements.txt'
        }
    }
}

stage('Run Application') {
    steps {
        dir('python') {
            sh 'python3 app.py'
        }
    }
}

stage('Run Tests') {
    steps {
        dir('python') {
            sh 'python3 -m unittest -v test_app'
        }
    }
}